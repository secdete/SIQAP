# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/siqap?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-development-key-change-in-prod"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Generator (Gemini langsung dari Google AI Studio, bukan proxy)
# Ambil key di https://aistudio.google.com/apikey (diawali "AIza...")
GEMINI_API_KEY=""
AI_MODEL="gemini-3.8-flash"

# Realtime Server
PORT=3001
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
